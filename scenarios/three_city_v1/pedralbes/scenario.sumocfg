<?xml version='1.0' encoding='utf-8'?>
<configuration><input><net-file value="city.net.xml" /><route-files value="routes.rou.xml" /><additional-files value="buildings.poly.xml,infrastructure.add.xml" /></input><time><end value="2400" /><step-length value="0.5" /></time><processing><time-to-teleport value="-1" /></processing><random_number><seed value="4101" /></random_number><output><tripinfo-output value="tripinfo.xml" /><tripinfo-output.write-unfinished value="true" /><statistic-output value="statistics.xml" /></output><report><no-step-log value="true" /><error-log value="errors.log" /></report><gui_only><gui-settings-file value="view.xml" /></gui_only></configuration>